# --- WhatsApp Cloud API (Meta) -------------------------------------------
# Leave WHATSAPP_TOKEN empty to run in dry-run mode (replies are printed, nothing is sent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
VERIFY_TOKEN=pick-a-long-random-string
APP_SECRET=
HASH_SALT=pick-another-long-random-string

# --- AI (free-form questions + optional photo check) -----------------------
# Leave empty to run with the scripted guide only (zero AI cost).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# --- Spend protection (INR). These are the numbers that keep you safe. -------
DAILY_BUDGET_INR=300
MONTHLY_BUDGET_INR=6000
PER_USER_DAILY_LLM_CALLS=8
PER_USER_DAILY_MSGS=150

# --- Features -------------------------------------------------------------
# Photo check reads ID photos with AI. Keep OFF until your privacy notice is public (/privacy).
DOC_CHECK=0
ADMIN_KEY=

# --- Only change these if prices change ------------------------------------
USD_INR=90
LLM_IN_USD_PER_M=1
LLM_OUT_USD_PER_M=5
WA_MSG_INR=0.14

# --- v2 ---
VAULT_KEY=change-me-to-a-long-random-string     # encrypts saved profiles (AES-256-GCM)
DETAILS_FLOW_ID=                                # WhatsApp Flow id for the details form (needs Meta business verification). Empty = asks one question at a time.
STRIPE_SECRET_KEY=                              # Stripe secret key: sk_test_... first, sk_live_... for real money
STRIPE_WEBHOOK_SECRET=                          # signing secret (whsec_...) of the endpoint https://YOUR-DOMAIN/stripe for checkout.session.completed
# Days without a message before saved details (profile, locker, reminders) are erased. A wallet balance is never deleted for inactivity.
ACCOUNT_KEEP_DAYS=180
# Prices in paise (placeholders to test): TRIAL_PAISE=500 FREE_MSGS_PER_DAY=40 MSG_PAISE=15 AI_PAISE=50 SCAN_PAISE=100 SHEET_PAISE=300 PAN_PACK_PAISE=4900

# --- v3: voice, reminders, languages ---
SARVAM_API_KEY=                                 # voice notes, tried first (good for Indian languages)
OPENAI_API_KEY=                                 # voice fallback (whisper-1). Either key turns voice on.
# SARVAM_BASE=  SARVAM_MODEL=saaras:v4  OPENAI_BASE=  OPENAI_STT_MODEL=whisper-1
STT_INR_PER_HOUR=30                             # only used for the spend counter
REMINDER_TEMPLATE=saathi_reminder               # approved template; the Hindi one is saathi_reminder_hi
# VOICE_PAISE=50 REMIND_PAISE=200

# --- v4: web app (for people without WhatsApp) ---
WHATSAPP_NUMBER=                                # your public WhatsApp number with country code, digits only. Adds a "Chat on WhatsApp" button in the web app.
TRUST_PROXY=1                                   # set to 1 on Render/Fly so limits use the visitor's real address
# WEB_MSGS_PER_MIN=20  WEB_MSGS_PER_MIN_IP=120  WEB_NEW_PER_IP_PER_DAY=20

# --- AI: pick one. OpenRouter can use FREE models (get a key at openrouter.ai/keys) ---
OPENROUTER_API_KEY=                             # if set, used instead of Anthropic
OPENROUTER_MODEL=stealth/space-bunny-alpha      # free, fast, reads images (checked on OpenRouter 2026-09-30). Stealth models can be retired without notice
OPENROUTER_FALLBACKS=openrouter/free            # comma-separated, tried in order if the first is busy or gone
