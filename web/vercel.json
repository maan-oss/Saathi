{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/fonts/instrument.woff2",
      "destination": "/fonts/instrument-sans-latin-standard-normal.woff2"
    },
    {
      "source": "/fonts/bricolage.woff2",
      "destination": "/fonts/bricolage-grotesque-latin-wght-normal.woff2"
    },
    {
      "source": "/favicon.ico",
      "destination": "/icon-192.png"
    },
    {
      "source": "/privacy",
      "destination": "https://saathi-acme-7340.vercel.app/privacy"
    },
    {
      "source": "/app",
      "destination": "https://saathi-acme-7340.vercel.app/app"
    },
    {
      "source": "/app/:path*",
      "destination": "https://saathi-acme-7340.vercel.app/app/:path*"
    }
  ]
}
